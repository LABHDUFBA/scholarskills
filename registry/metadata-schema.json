{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labhdufba.github.io/scholarskills/schema/registry-entry.json",
  "title": "ScholarSkills registry entry",
  "type": "object",
  "required": [
    "id",
    "slug",
    "title",
    "status",
    "stage",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SS-[0-9]{4}$",
      "description": "Catalog identifier, assigned on acceptance."
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "title_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "planned",
        "available",
        "deprecated"
      ]
    },
    "type": {
      "enum": [
        "methodological",
        "infrastructure",
        "meta"
      ],
      "description": "Editorial type; preliminary until confirmed by authors."
    },
    "maturity": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "experimental",
        "tested",
        "peer-reviewed",
        "replicated",
        null
      ]
    },
    "repository": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "doi_version": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "doi_concept": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^10\\.[0-9]{4,9}/[-._;()/:A-Za-z0-9]+$"
    },
    "doi_record": {
      "type": [
        "string",
        "null"
      ],
      "format": "uri"
    },
    "license": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "affiliation": {
            "type": [
              "string",
              "null"
            ]
          },
          "orcid": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"
          },
          "github": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "skill_spec_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "compatibility": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "functional": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "methodological": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "peer_review": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "reexecution": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "replication": {
          "type": "object",
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "properties": {
            "status": {
              "enum": [
                "recorded",
                "not_recorded",
                "not_applicable"
              ]
            },
            "note": {
              "type": "string"
            },
            "note_pt": {
              "type": "string"
            },
            "ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "limits": {
      "type": [
        "string",
        "null"
      ]
    },
    "limits_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "deprecated_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "added": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "objective": {
      "type": [
        "string",
        "null"
      ]
    },
    "objective_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "how_it_works": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "how_it_works_pt": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "install": {
      "type": [
        "string",
        "null"
      ]
    },
    "install_pt": {
      "type": [
        "string",
        "null"
      ]
    },
    "cite": {
      "type": [
        "string",
        "null"
      ]
    },
    "links": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^https?://\\S+$"
      }
    },
    "links_pt": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "highlight": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "stage": {
      "type": "string"
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features_en": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disciplines": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "available"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "version",
          "maturity",
          "license",
          "repository",
          "authors"
        ]
      }
    }
  ]
}
